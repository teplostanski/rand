{
  "name": "rand",
  "description": "A small service for generating cryptographically secure random data through a simple API.",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.16.0 || >=26.1.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fastify/accepts": "^5.0.7",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "fastify": "5.12.8",
    "isbot": "^5.2.3",
    "nanoid": "^6.0.2",
    "undevice": "1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@teplostanski/biome-config": "^2.0.3",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
